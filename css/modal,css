.modal-overlay{

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.45);

    display:none;

    align-items:center;

    justify-content:center;

    z-index:9999;

}

.modal{

    background:#fff;

    width:700px;

    max-width:95%;

    border-radius:8px;

    overflow:hidden;

    box-shadow:0 8px 25px rgba(0,0,0,.30);

}

.modal-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:14px 20px;

    border-bottom:1px solid #ddd;

}

.modal-body{

    padding:20px;

}

.modal-footer{

    padding:15px 20px;

    border-top:1px solid #ddd;

    display:flex;

    justify-content:flex-end;

    gap:10px;

}

.modal-close{

    border:none;

    background:none;

    cursor:pointer;

    font-size:22px;

}
